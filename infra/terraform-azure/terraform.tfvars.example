# Graphwise Stack — example Terraform variables for the AZURE module.
#
# Copy this file to terraform.tfvars and fill in your per-deployment
# values. terraform.tfvars is gitignored — never commit real values.
#
# === DO NOT EDIT variables.tf ==============================================
# variables.tf is module source. Every per-deployment knob lives in THIS
# file. If you find yourself wanting to "just change the default in
# variables.tf", set the value here instead — that's what tfvars is for,
# and it keeps the module reusable across deployments.
#
# Every variable is described at length in variables.tf. Read README.md
# first — the Azure path has three behaviours that differ from AWS and
# will cost you money or a rebuild if you meet them by surprise.

# === REQUIRED ===============================================================

# Azure subscription to deploy into. Get it with:
#   az account show --query id -o tsv
# Leave empty to use ARM_SUBSCRIPTION_ID / the `az account set` default.
subscription_id = "CHANGEME"

# Azure region. Pick something close to you for low SSH latency. MUST offer
# the vm_size below — memory-optimized E-series availability is regional.
# Verify BEFORE your first apply:
#   az vm list-skus --location westus2 --size Standard_E8 --output table
location = "westus2"

# Parent domain that hosts your subdomain. DNS stays in ROUTE 53 even
# though the VM is on Azure — see README.md "Why Route 53 stays". Nothing
# about the domain moves to Azure DNS.
base_domain = "example.com"                  # CHANGEME -- no default; must be a zone you control

# Route 53 hosted zone ID for base_domain. Get it once with:
#   aws route53 list-hosted-zones --query 'HostedZones[?Name==`<base_domain>.`].Id' --output text | sed 's|/hostedzone/||'
# The validation regex accepts any well-formed ID, including a WRONG one
# from another account. Verify the value — see TERRAFORM_NOTES.md's write-up of the
# wrong-zone-id failure (cert-manager AccessDenied, cert never issues).
route53_zone_id = "CHANGEME"

# Email for the Let's Encrypt ACME account. LE rejects @example.com/.org/.net.
le_email = "CHANGEME@gmail.com"

# Your subdomain under base_domain. Final hostnames:
#   <subdomain>.<base_domain>           -- Console landing
#   <app>.<subdomain>.<base_domain>     -- every app (poolparty, auth, ...)
subdomain = "CHANGEME"                       # e.g. "scott", or multi-level "demo.team"

# Operator-attribution tags surfaced on every Azure resource (Cost
# Management, Azure Policy). `creator` is REQUIRED — validation rejects an
# empty string so nothing lands in the subscription anonymously.
creator = "CHANGEME"                         # e.g. "Kent Stroker"
purpose = "CHANGEME"                         # e.g. "Chevron presales demo"

# Path to the SSH PUBLIC key installed on the VM's admin account. Azure has
# no EC2-style key pair to pre-create — you hand it the public key material
# and keep the private half locally.
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Your current public IPv4 + /32. Check with `curl -4 icanhazip.com`.
# Applies to ports 22, 80 AND 443. NEVER 0.0.0.0/0.
admin_cidr = "CHANGEME/32"                   # e.g. "203.0.113.42/32"


# === STRONGLY RECOMMENDED ===================================================

# Pre-created Static/Standard Public IP, in a resource group that this
# module does NOT manage. This matters more on Azure than the EIP does on
# AWS: `terraform destroy` deletes the whole resource group, so an IP
# created by this module is GUARANTEED to be lost on every rebuild, taking
# your Route 53 A records with it.
#
# Create it once (note the DIFFERENT resource group):
#   az group create --name graphwise-shared-rg --location westus2
#   az network public-ip create \
#       --name graphwise-<subdomain>-pip \
#       --resource-group graphwise-shared-rg \
#       --location westus2 --sku Standard --allocation-method Static
#
# Leave both empty to allocate a fresh IP each apply (then re-point DNS
# after every rebuild).
existing_public_ip_name                = "CHANGEME"
existing_public_ip_resource_group_name = "graphwise-shared-rg"


# === MARKETPLACE IMAGE — VERIFY BEFORE FIRST APPLY ==========================
#
# There is no Amazon Linux 2023 on Azure, so the distro choice reopens.
# The shipped defaults are Rocky Linux 9, which keeps the AWS module's
# `dnf` flow almost verbatim — but the exact publisher/offer/sku triple
# below is UNVERIFIED in this repo. Confirm it before your first apply:
#
#   az vm image list --publisher resf --all --output table
#   az vm image terms show --publisher resf --offer rockylinux-x86_64 --plan 9-base
#
# Rocky is a marketplace image with a purchase plan, so it needs a ONE-TIME
# per-subscription terms acceptance before any apply will succeed:
#
#   az vm image terms accept --publisher resf --offer rockylinux-x86_64 --plan 9-base
#
# Symptom of a wrong triple: apply fails with an unhelpful "image not
# found" / "no offer" error. Symptom of missing terms: "Legal terms have
# not been accepted for this item on this subscription".
#
# Alternatives, in order of how much of user-data.sh.tpl they preserve:
#   Rocky 9   resf     / rockylinux-x86_64 / 9-base       (dnf — default)
#   Alma 9    almalinux/ almalinux-x86_64  / 9-gen2       (dnf)
#   RHEL 9    RedHat   / RHEL              / 9-lvm-gen2   (dnf, PAYG surcharge,
#                                                          image_has_plan=false)
#   Ubuntu 24 Canonical/ ubuntu-24_04-lts  / server       (apt — user-data
#                                                          MUST be rewritten,
#                                                          image_has_plan=false)
# image_publisher = "resf"
# image_offer     = "rockylinux-x86_64"
# image_sku       = "9-base"
# image_has_plan  = true

# Image version pin. Leave "latest" for the FIRST apply only. Then run
#   terraform output -raw image_pin_command
# execute what it prints, and paste the concrete version here + re-apply
# (expect "no changes"). Same hazard as the AWS module's ami_override.
# image_version = "9.6.2025...."


# === OPTIONAL (defaults are recommended) ====================================

# VM size. Standard_E8s_v5 = 8 vCPU / 64 GiB x86_64, the direct equivalent
# of the AWS module's r6g.2xlarge. x86_64 is deliberate — it also lets the
# stack pull ontotext/refine directly instead of the bundled arm64
# workaround. Standard_E8ps_v5 is the ARM64 twin if you want it.
# vm_size = "Standard_E8s_v5"

# OS disk. 300 GiB is the shipped recommendation (KIND image cache + PVCs).
# Premium_LRS is the gp3 equivalent; StandardSSD_LRS will feel slow.
# os_disk_gb   = 300
# os_disk_type = "Premium_LRS"

# Admin account name. Defaults to "ec2-user" ON PURPOSE even on Azure —
# /home/ec2-user is hardcoded in infra/kind/kind-config.yaml (which has no
# templating path at all) and in the chart templates. Changing this means
# introducing templating for those files. See README.md.
# admin_username = "ec2-user"

# AUTO-SHUTDOWN — READ THIS. Unlike the AWS module's idle-CPU CloudWatch
# alarm, Azure has no native idle-based VM stop, so this is TIME-based: it
# deallocates the VM at the configured local hour whether or not a demo is
# in progress. Set the notification email so you get a 30-minute warning
# with a "postpone" link. Set auto_shutdown_enabled = false on demo days.
# auto_shutdown_enabled            = true
# auto_shutdown_time               = "1900"                  # 24h HHMM, no colon
# auto_shutdown_timezone           = "Pacific Standard Time" # Windows tz name, not IANA
auto_shutdown_notification_email = "CHANGEME@gmail.com"

# Path to the static Route 53 IAM key pair used by cert-manager's DNS-01
# solver (the Azure replacement for the AWS instance role). Defaults to
# route53-credentials.env next to this module. Three lines:
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_REGION=us-west-2
# The file's contents land in Terraform state — treat state as a secret.
# route53_credentials_file = "./route53-credentials.env"

# Repo + branch cloned on first boot.
# github_repo_url = "https://github.com/kentstroker/graphwise-stack-builder.git"
# github_branch   = "main"

# Tool pins baked into cloud-init. Do NOT bump kind_version past a node
# image whose containerd exceeds the host's — see README.md "Known risks".
# kind_version    = "v0.30.0"
# kubectl_version = "v1.33.4"
# helm_version    = "v3.17.0"

# Resource group name. Auto-named "<prefix>-<subdomain-slug>-rg" when empty.
# terraform destroy DELETES this group and everything in it.
# resource_group_name = ""

# Name prefix for every resource. Final name is "<prefix>-<subdomain>-<role>".
# instance_name_prefix = "graphwise-stack"

# Extra tags merged onto every resource (module defaults lose on conflict).
extra_tags = {
  ownerOrganizationId = "gws"
  project             = "demo"
  ownerOUid           = "pse"
}
